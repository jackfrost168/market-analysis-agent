# Local Ollama generation endpoint and optional default model.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags
OLLAMA_MODEL=qwen3:8b
PREDICTION_DATA_PROVIDER=coinrithm

# Optional API-equivalent estimate for evaluation reports. Local Ollama itself
# has no metered token fee; leave these blank when no comparison rate is needed.
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=

# Leave blank to use the deterministic local hash embedding fallback.
OLLAMA_EMBED_MODEL=
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed

# SEC asks API users to identify the application and a contact address.
SEC_USER_AGENT=Stateful-Market-Agent/1.0 your-email@example.com

HOST=127.0.0.1
PORT=8001

# Persistent SQLite directory. Set this to a writable mounted path on AWS.
AGENT_DATA_DIR=./data

# Optional post-analysis evidence ablations. Disabled preserves the existing workflow/report.
ENABLE_COUNTERFACTUAL_EVIDENCE_TEST=false
COUNTERFACTUAL_MAX_CLAIMS=1
COUNTERFACTUAL_MAX_EVIDENCE=3
COUNTERFACTUAL_BUDGET_SECONDS=60
COUNTERFACTUAL_CALL_TIMEOUT_SECONDS=15
