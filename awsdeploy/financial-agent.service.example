[Unit]
Description=Stateful Market Agent FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/financial-agent
Environment=PYTHONUNBUFFERED=1
Environment=AGENT_DATA_DIR=/home/ec2-user/financial-agent/data
EnvironmentFile=-/home/ec2-user/financial-agent/.env
ExecStart=/home/ec2-user/financial-agent/.venv/bin/python -m uvicorn awsdeploy.api:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
